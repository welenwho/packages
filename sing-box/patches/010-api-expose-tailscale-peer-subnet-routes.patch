@@ -0,0 +1,59 @@
+package main
+
+import (
+	"github.com/sagernet/sing/common"
+
+	"github.com/spf13/cobra"
+)
+
+var commandAPITailscaleRoute = &cobra.Command{
+	Use:   "route",
+	Short: "Manage Tailscale subnet routes",
+}
+
+var commandAPITailscaleRouteList = &cobra.Command{
+	Use:   "list",
+	Short: "List Tailscale peer subnet routes",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, args []string) error {
+		return runAPITailscaleRouteList()
+	},
+}
+
+func init() {
+	commandAPITailscaleRoute.PersistentFlags().StringVar(&commandAPITailscaleFlagEndpoint, "endpoint", "", commandAPITailscaleEndpointUsage)
+	commandAPITailscaleRoute.AddCommand(commandAPITailscaleRouteList)
+	commandAPITailscale.AddCommand(commandAPITailscaleRoute)
+}
+
+func runAPITailscaleRouteList() error {
+	clientConn, client, err := createAPIClient()
+	if err != nil {
+		return err
+	}
+	defer clientConn.Close()
+	endpoint, err := fetchTailscaleEndpoint(client)
+	if err != nil {
+		return err
+	}
+	entries := common.Filter(tailscalePeerEntries(endpoint), func(it tailscalePeerEntry) bool {
+		return !it.self && len(it.peer.GetPrimaryRoutes()) > 0
+	})
+	sortTailscalePeerEntries(entries)
+	table := tableWriter{
+		header:       []string{"ROUTE", "DNS NAME", "IP", "ONLINE"},
+		emptyMessage: "no subnet routes",
+	}
+	for _, entry := range entries {
+		for _, route := range entry.peer.GetPrimaryRoutes() {
+			table.addRow(
+				route,
+				tailscalePeerName(entry.peer),
+				tailscalePeerAddress(entry.peer),
+				formatYesNo(entry.peer.GetOnline()),
+			)
+		}
+	}
+	table.flush()
+	return nil
+}
