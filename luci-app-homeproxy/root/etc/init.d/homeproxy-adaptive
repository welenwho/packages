#!/bin/sh /etc/rc.common

USE_PROCD=1

START=98
STOP=11

CONFIG='homeproxy-adaptive'

prepare_runtime() {
	HOMEPROXY_ADAPTIVE_PREPARE=1 \
		/usr/bin/ucode -S /etc/homeproxy/scripts/adaptive.uc
}

start_service() {
	config_load "$CONFIG"
	local enabled routing_mode allow_global
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	routing_mode="$(uci -q get homeproxy.config.routing_mode)"
	case "$routing_mode" in
	custom|bypass_mainland_china) ;;
	global)
		config_get_bool allow_global main allow_global 0
		[ "$allow_global" -eq 1 ] || return 0
		;;
	*) return 0 ;;
	esac

	prepare_runtime || return 1

	procd_open_instance 'worker'
	procd_set_param command /usr/bin/ucode -S /etc/homeproxy/scripts/adaptive.uc
	procd_set_param nice 10
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}

reload_service() {
	stop
	start
}
