{
  "log": { "disabled": true },
  "dns": {
    "servers": [
      { "type": "local", "tag": "local-dns" }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 45117
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct-out" },
    { "type": "direct", "tag": "homeproxy-adaptive-final-direct-out" },
    { "type": "direct", "tag": "proxy-test" },
    {
      "type": "selector",
      "tag": "homeproxy-adaptive-out",
      "outbounds": ["proxy-test"],
      "default": "proxy-test",
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "rule_set": "adaptive-test",
        "action": "route",
        "outbound": "homeproxy-adaptive-out"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "adaptive-test",
        "format": "source",
        "path": "/tmp/homeproxy-adaptive-hot-rules.json"
      }
    ],
    "final": "homeproxy-adaptive-final-direct-out",
    "auto_detect_interface": true,
    "default_domain_resolver": "local-dns"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:45118"
    }
  }
}
