msgid "Tailscale"
msgstr "Tailscale"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:96
msgid "Need to log in"
msgstr "未登录"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:97
msgid "Waiting for login URL"
msgstr "正在等待登录链接"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:100
msgid "Waiting for machine approval"
msgstr "正在等待设备审批"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:102
msgid "Connected"
msgstr "已连接"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:103
msgid "Log out and Unbind"
msgstr "注销登录并解除绑定"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:123
msgid "Tailscale is a cross-platform and easy to use virtual LAN."
msgstr "Tailscale 是一个跨平台且易于使用的虚拟局域网 VPN。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:139
msgid "Are you sure you want to log out and unbind the current device?"
msgstr "是否注销当前登录并且解绑当前设备？"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:151
msgid "Basic Settings"
msgstr "基础设置"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:152
msgid "Routing"
msgstr "路由"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:153
msgid "Security"
msgstr "安全"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:154
msgid "Peer Relay"
msgstr "对等中继"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:155
msgid "Authentication"
msgstr "认证"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:156
msgid "Extra Settings"
msgstr "附加设置"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:158
msgid "Enable"
msgstr "启用"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:162
msgid "Login Status"
msgstr "已绑定用户"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:168
msgid "UDP Port"
msgstr "UDP 端口"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:168
msgid "Listening port for direct Tailscale connections."
msgstr "Tailscale 直连使用的监听端口。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:173
msgid "State Directory"
msgstr "状态目录"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:173
msgid "Directory containing the persistent tailscaled state file."
msgstr "保存 tailscaled 持久状态文件的目录。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:177
msgid "The state directory must be an absolute path."
msgstr "状态目录必须使用绝对路径。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:180
msgid "Firewall Backend"
msgstr "防火墙后端"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:180
msgid "Select the firewall implementation used internally by tailscaled."
msgstr "选择 tailscaled 内部使用的防火墙实现。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:181
msgid "Auto"
msgstr "自动"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:187
msgid "Device Name"
msgstr "设备名称"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:187
msgid "Leave blank to use the device's hostname."
msgstr "留空以使用设备的主机名。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:190
msgid "Accept DNS"
msgstr "允许DNS"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:190
msgid "Accept DNS configuration from the Tailscale admin console."
msgstr "使用 Tailscale 管理控制台的 DNS 配置。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:194
msgid "Device Posture Reporting"
msgstr "设备状态上报"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:194
msgid "Allow the management plane to gather device posture information."
msgstr "允许管理平面收集设备状态信息。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:198
msgid "StdOut Log"
msgstr "运行日志"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:198
msgid "Logging program activities."
msgstr "记录程序运行信息。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:202
msgid "StdErr Log"
msgstr "错误日志"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:202
msgid "Logging program errors and exceptions."
msgstr "记录程序错误和警告信息。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:206
msgid "Accept Routes"
msgstr "启用路由"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:206
msgid "Accept subnet routes that other nodes advertise."
msgstr "接受其他节点广播的子网路由。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:210
msgid "Advertise Exit Node"
msgstr "广播出口节点"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:210
msgid "Offer this device as an exit node for the tailnet."
msgstr "将此设备作为 tailnet 的出口节点。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:214
msgid "Use Exit Node"
msgstr "使用出口节点"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:214
msgid ""
"Select a specific online exit node or let Tailscale choose automatically."
msgstr "选择指定的在线出口节点，或由 Tailscale 自动选择。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:215
#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/interface.js:78
msgid "None"
msgstr "无"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:216
msgid "Automatic (any)"
msgstr "自动（任意节点）"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:220
msgid "offline or unavailable"
msgstr "离线或不可用"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:225
msgid "Allow LAN Access with Exit Node"
msgstr "使用出口节点时允许访问 LAN"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:225
msgid "Keep direct access to local LAN subnets while using an exit node."
msgstr "使用出口节点时保留对本地 LAN 子网的直接访问。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:230
msgid "Advertise Subnets"
msgstr "广播子网"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:230
msgid ""
"Expose physical network routes into Tailscale, e.g. <code>10.0.0.0/8</code>."
msgstr "向 Tailscale 广播物理网络路由，例如 <code>10.0.0.0/8</code>。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:236
msgid "Site To Site"
msgstr "子网互通"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:236
msgid "Disable source NAT for advertised subnet routes."
msgstr "禁用所广播子网路由的源地址转换。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:240
msgid "Static Peer Routes"
msgstr "静态对端路由"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:240
msgid ""
"Install explicit OpenWrt routes through tailscale0 for selected peer subnets."
msgstr "为选定的对端子网安装经由 tailscale0 的 OpenWrt 显式路由。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:247
msgid "App Connector"
msgstr "应用连接器"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:247
msgid "Offer this device as an app connector for domain-specific routes."
msgstr "将此设备作为域名专用路由的应用连接器。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:251
msgid "OpenWrt Forwarding"
msgstr "OpenWrt 转发"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:252
msgid "Tailscale access LAN"
msgstr "虚拟局域网访问本地局域网"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:253
msgid "Tailscale access WAN"
msgstr "虚拟局域网访问本地广域网"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:254
msgid "LAN access Tailscale"
msgstr "本地局域网访问虚拟局域网"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:255
msgid "WAN access Tailscale"
msgstr "本地广域网访问虚拟局域网"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:259
msgid "Netfilter Mode"
msgstr "Netfilter 模式"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:259
msgid "Control how Tailscale installs packet-filtering rules."
msgstr "控制 Tailscale 安装数据包过滤规则的方式。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:260
msgid "On"
msgstr "开启"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:261
msgid "No divert"
msgstr "不接管规则跳转"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:262
msgid "Off"
msgstr "关闭"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:266
msgid "Stateful Filtering"
msgstr "有状态过滤"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:266
msgid "Apply stateful filtering to packets forwarded by this router."
msgstr "对由此路由器转发的数据包应用有状态过滤。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:270
msgid "Shields Up"
msgstr "屏蔽入站连接"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:270
msgid "Block incoming Tailscale connections to this device."
msgstr "阻止其他 Tailscale 节点连接此设备。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:274
msgid "Tailscale SSH"
msgstr "Tailscale SSH"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:274
msgid ""
"Run the Tailscale SSH server. Ensure it does not conflict with Dropbear on "
"tailscale0 port 22."
msgstr ""
"运行 Tailscale SSH 服务。请确认它不会与 tailscale0 上监听 22 端口的 Dropbear "
"冲突。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:278
msgid "Enable Peer Relay"
msgstr "启用对等中继"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:282
msgid "Relay UDP Port"
msgstr "中继 UDP 端口"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:282
msgid "Use 0 to let Tailscale select a random available port."
msgstr "填写 0 时由 Tailscale 随机选择可用端口。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:288
msgid "Static Relay Endpoints"
msgstr "静态中继端点"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:288
msgid "Public IP:port endpoints advertised to relay clients."
msgstr "向中继客户端广播的公网 IP:端口 端点。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:293
msgid "Use IPv4:port or [IPv6]:port format."
msgstr "请使用 IPv4:端口 或 [IPv6]:端口 格式。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:296
msgid "Control Server"
msgstr "控制服务器"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:300
msgid "Auth Key"
msgstr "认证密钥"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:300
msgid "Used only while registering a logged-out node."
msgstr "仅在注册未登录节点时使用。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:304
msgid "Auth Key File"
msgstr "认证密钥文件"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:304
msgid ""
"Absolute path to a file containing the authentication key. This takes "
"precedence over Auth Key."
msgstr "包含认证密钥的文件绝对路径。此项优先于认证密钥。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:308
msgid "The auth key file must use an absolute path."
msgstr "认证密钥文件必须使用绝对路径。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:311
#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/interface.js:89
msgid "ACL Tags"
msgstr "ACL 标签"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:311
msgid ""
"Registration tags such as <code>tag:router</code>. Changes apply on the next "
"login."
msgstr "注册标签，例如 <code>tag:router</code>。修改将在下次登录时生效。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:316
msgid "Tags must use the tag:name format."
msgstr "标签必须使用 tag:name 格式。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:329
msgid "WireGuard Batch Size"
msgstr "WireGuard 批处理大小"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:330
msgid "Controls Linux packet batching. Smaller values reduce memory usage but may lower throughput."
msgstr "控制 Linux 数据包批处理。较小的值可降低内存占用，但可能降低吞吐量。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:331
msgid "Default (128)"
msgstr "默认（128）"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:338
msgid "Additional Login Flags"
msgstr "附加登录参数"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:339
#, javascript-format
msgid ""
"Compatibility flags used only during initial login. Prefer the dedicated "
"settings above. See %s."
msgstr "仅在首次登录时使用的兼容参数。请优先使用上方的专用设置。参见 %s。"

#: luci-app-tailscale/htdocs/luci-static/resources/view/tailscale/setting.js:340
msgid "tailscale up flags"
msgstr "tailscale up 参数"

