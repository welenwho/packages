FUNCTIONS_LIB="${TAILSCALE_FUNCTIONS_LIB:-/lib/functions.sh}"
. "$FUNCTIONS_LIB"

TAILSCALE_BIN="${TAILSCALE_BIN:-/usr/sbin/tailscale}"
LOCK_FILE="${TAILSCALE_LOCK_FILE:-/var/lock/tailscale.lock}"
TAILSCALE_SET_HELP=''
TAILSCALE_SET_HELP_LOADED=0

log_error() {
	logger -p daemon.err -t tailscale_helper "$(date '+%Y/%m/%d %H:%M:%S') $*"
}

fail() {
	log_error "$*"
	exit 1
}

bool_arg() {
	[ "$1" = "1" ] && printf true || printf false
}

space_to_csv() {
	printf '%s' "$1" | tr ' ' ','
}

supports_set_flag() {
	local flag="$1"

	if [ "$TAILSCALE_SET_HELP_LOADED" != "1" ]; then
		TAILSCALE_SET_HELP="$($TAILSCALE_BIN set --help 2>&1)"
		TAILSCALE_SET_HELP_LOADED=1
	fi
	printf '%s\n' "$TAILSCALE_SET_HELP" | grep -q -- "--$flag"
}

backend_state() {
	local status state

	status="$($TAILSCALE_BIN status --json 2>/dev/null)" || return 1
	if command -v jsonfilter >/dev/null 2>&1; then
		state="$(printf '%s' "$status" | jsonfilter -e '@.BackendState' 2>/dev/null)"
	else
		state="$(printf '%s\n' "$status" | sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
	fi
	[ -n "$state" ] || return 1
	printf '%s' "$state"
}

magicdns_suffix() {
	local status suffix

	status="$($TAILSCALE_BIN status --json 2>/dev/null)" || return 1
	if command -v jsonfilter >/dev/null 2>&1; then
		suffix="$(printf '%s' "$status" | jsonfilter -e '@.MagicDNSSuffix' 2>/dev/null)"
	else
		suffix="$(printf '%s\n' "$status" | sed -n 's/.*"MagicDNSSuffix"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
	fi
	[ -n "$suffix" ] || return 1
	printf '%s' "$suffix"
}

load_settings() {
	local cfg="settings"

	config_load tailscale
	config_get_bool ACCEPT_ROUTES "$cfg" accept_routes 0
	config_get HOSTNAME "$cfg" hostname
	config_get_bool ACCEPT_DNS "$cfg" accept_dns 1
	config_get_bool MAGIC_DNS "$cfg" magic_dns 1
	config_get_bool UPDATE_CHECK "$cfg" update_check 1
	config_get_bool AUTO_UPDATE "$cfg" auto_update 0
	config_get_bool WEBCLIENT "$cfg" webclient 0
	config_get_bool ADVERTISE_EXIT_NODE "$cfg" advertise_exit_node 0
	config_get EXIT_NODE "$cfg" exit_node
	config_get_bool EXIT_NODE_ALLOW_LAN_ACCESS "$cfg" exit_node_allow_lan_access 0
	config_get ADVERTISE_ROUTES "$cfg" advertise_routes
	config_get_bool DISABLE_SNAT_SUBNET_ROUTES "$cfg" disable_snat_subnet_routes 0
	config_get SUBNET_ROUTES "$cfg" subnet_routes
	config_get ACCESS "$cfg" access
	config_get NETFILTER_MODE "$cfg" netfilter_mode on
	config_get_bool STATEFUL_FILTERING "$cfg" stateful_filtering 0
	config_get_bool SHIELDS_UP "$cfg" shields_up 0
	config_get_bool ADVERTISE_CONNECTOR "$cfg" advertise_connector 0
	config_get ADVERTISE_TAGS "$cfg" advertise_tags
	config_get_bool TAILSCALE_SSH "$cfg" tailscale_ssh 0
	config_get_bool REPORT_POSTURE "$cfg" report_posture 0
	config_get_bool RELAY_SERVER_ENABLED "$cfg" relay_server_enabled 0
	config_get RELAY_SERVER_PORT "$cfg" relay_server_port 0
	config_get RELAY_SERVER_STATIC_ENDPOINTS "$cfg" relay_server_static_endpoints
	config_get FLAGS "$cfg" flags
	config_get LOGIN_SERVER "$cfg" login_server
	config_get AUTHKEY "$cfg" authkey
	# Migrate the spelling used by releases before 1.3 without exposing the key.
	[ -n "$AUTHKEY" ] || config_get AUTHKEY "$cfg" authKey
	config_get AUTH_KEY_FILE "$cfg" auth_key_file

	case "$NETFILTER_MODE" in
		on|nodivert|off) ;;
		*) NETFILTER_MODE=on ;;
	esac
	case "$RELAY_SERVER_PORT" in
		''|*[!0-9]*) RELAY_SERVER_PORT=0 ;;
	esac
}

wait_for_localapi() {
	local count=0 state

	while [ "$count" -lt 30 ]; do
		state="$(backend_state)"
		case "$state" in
			Running|NeedsLogin|NeedsMachineAuth|Stopped)
				printf '%s' "$state"
				return 0
				;;
		esac
		count=$((count + 1))
		sleep 1
	done
	return 1
}

login_if_needed() {
	local state="$1" flag auth_arg

	case "$state" in
		Running|NeedsMachineAuth)
			return 0
			;;
	esac

	set -- "$TAILSCALE_BIN" up
	if [ -n "$AUTH_KEY_FILE" ]; then
		case "$AUTH_KEY_FILE" in
			/*) auth_arg="file:$AUTH_KEY_FILE" ;;
			*) fail "Auth key file must use an absolute path." ;;
		esac
	elif [ -n "$AUTHKEY" ]; then
		auth_arg="$AUTHKEY"
	fi
	[ -n "$auth_arg" ] && set -- "$@" "--auth-key=$auth_arg"
	[ -n "$LOGIN_SERVER" ] && set -- "$@" "--login-server=$LOGIN_SERVER"
	[ -n "$ADVERTISE_TAGS" ] && set -- "$@" "--advertise-tags=$(space_to_csv "$ADVERTISE_TAGS")"

	# Extra flags are retained for compatibility and only take effect at login.
	for flag in $FLAGS; do
		case "$flag" in
			--*) set -- "$@" "$flag" ;;
			*) log_error "Ignoring invalid extra flag: $flag" ;;
		esac
	done

	"$@" || fail "tailscale up failed."
}

sync_preferences() {
	local relay_port='' relay_endpoints=''

	if [ "$RELAY_SERVER_ENABLED" = "1" ]; then
		relay_port="$RELAY_SERVER_PORT"
		relay_endpoints="$(space_to_csv "$RELAY_SERVER_STATIC_ENDPOINTS")"
	fi

	set -- "$TAILSCALE_BIN" set \
		"--accept-routes=$(bool_arg "$ACCEPT_ROUTES")" \
		"--accept-dns=$(bool_arg "$ACCEPT_DNS")" \
		"--advertise-exit-node=$(bool_arg "$ADVERTISE_EXIT_NODE")" \
		"--advertise-routes=$(space_to_csv "$ADVERTISE_ROUTES")" \
		"--snat-subnet-routes=$(bool_arg "$((1 - DISABLE_SNAT_SUBNET_ROUTES))")" \
		"--exit-node=$EXIT_NODE" \
		"--exit-node-allow-lan-access=$(bool_arg "$EXIT_NODE_ALLOW_LAN_ACCESS")" \
		"--hostname=$HOSTNAME" \
		"--netfilter-mode=$NETFILTER_MODE" \
		"--stateful-filtering=$(bool_arg "$STATEFUL_FILTERING")" \
		"--shields-up=$(bool_arg "$SHIELDS_UP")" \
		"--advertise-connector=$(bool_arg "$ADVERTISE_CONNECTOR")" \
		"--ssh=$(bool_arg "$TAILSCALE_SSH")" \
		"--report-posture=$(bool_arg "$REPORT_POSTURE")" \
		"--relay-server-port=$relay_port" \
		"--relay-server-static-endpoints=$relay_endpoints"

	if supports_set_flag update-check; then
		set -- "$@" "--update-check=$(bool_arg "$UPDATE_CHECK")"
	fi
	if supports_set_flag auto-update; then
		[ "$UPDATE_CHECK" = "1" ] || AUTO_UPDATE=0
		set -- "$@" "--auto-update=$(bool_arg "$AUTO_UPDATE")"
	fi
	if supports_set_flag webclient; then
		set -- "$@" "--webclient=$(bool_arg "$WEBCLIENT")"
	fi

	"$@" || fail "tailscale set failed."
}

remove_magicdns_entries() {
	local keep="$1" field suffix option

	for field in address server; do
		for option in $(uci show dhcp 2>/dev/null | sed -n "s/^\([^=]*\.$field\)=.*\/100\.100\.100\.100'.*/\1/p"); do
			for suffix in $(uci -q get "$option" 2>/dev/null); do
				case "$suffix" in
					/*/100.100.100.100)
						if [ "$field" = "server" ] && [ -n "$keep" ] && [ "$suffix" = "$keep" ]; then
							continue
						fi
						uci -q del_list "$option=$suffix"
						;;
				esac
			done
		done
	done
}

configure_magicdns() {
	local suffix target index i

	if [ "$MAGIC_DNS" = "1" ]; then
		suffix="$(magicdns_suffix)"
		[ -n "$suffix" ] && target="/$suffix/100.100.100.100"
	fi
	remove_magicdns_entries "$target"
	[ -n "$target" ] || return 0
	index="$(uci show dhcp 2>/dev/null | sed -n "s/^dhcp\.@dnsmasq\[\([0-9][0-9]*\)\]=dnsmasq$/\1/p")"
	for i in $index; do
		uci -q get "dhcp.@dnsmasq[$i].server" 2>/dev/null | tr ' ' '\n' | grep -qxF "$target" ||
			uci -q add_list "dhcp.@dnsmasq[$i].server=$target" || fail "Failed to add MagicDNS forwarding."
	done
}

configure_network() {
	local ts0 ts_ip ts_ip6 current_ip6 route route_index i=1

	ts0="$(ls /sys/class/net 2>/dev/null | sed -n '/^tailscale[0-9][0-9]*$/p' | head -n 1)"
	[ -n "$ts0" ] || fail "Tailscale interface was not created."
	ts_ip="$($TAILSCALE_BIN ip -4 2>/dev/null | head -n 1)"
	ts_ip6="$($TAILSCALE_BIN ip -6 2>/dev/null | head -n 1)"
	[ -n "$ts_ip" ] || fail "Failed to get Tailscale IPv4 address."

	uci -q batch <<-EOF || fail "Failed to configure the Tailscale interface."
		set network.tailscale='interface'
		set network.tailscale.proto='static'
		set network.tailscale.ipaddr='$ts_ip'
		set network.tailscale.netmask='255.192.0.0'
		set network.tailscale.device='$ts0'
	EOF
	current_ip6="$(uci -q get network.tailscale.ip6addr)"
	if [ "$current_ip6" != "$ts_ip6" ]; then
		uci -q delete network.tailscale.ip6addr
		[ -n "$ts_ip6" ] && uci -q add_list "network.tailscale.ip6addr=$ts_ip6"
	fi

	for route in $SUBNET_ROUTES; do
		uci -q batch <<-EOF || fail "Failed to configure subnet route $route."
			set network.ts_subnet$i='route'
			set network.ts_subnet$i.interface='tailscale'
			set network.ts_subnet$i.target='$route'
			set network.ts_subnet$i.gateway='$ts_ip'
		EOF
		i=$((i + 1))
	done
	for route in $(uci show network 2>/dev/null | sed -n "s/^\(network\.ts_subnet[0-9][0-9]*\)=route$/\1/p"); do
		route_index="${route#network.ts_subnet}"
		[ "$route_index" -lt "$i" ] || uci -q delete "$route"
	done
}

has_access() {
	case " $ACCESS " in
		*" $1 "*) return 0 ;;
		*) return 1 ;;
	esac
}

add_forwarding() {
	uci -q batch <<-EOF || fail "Failed to configure firewall forwarding $1."
		set firewall.$1='forwarding'
		set firewall.$1.src='$2'
		set firewall.$1.dest='$3'
	EOF
}

configure_firewall() {
	local section

	if [ -z "$ACCESS" ]; then
		for section in tszone ts_ac_lan ts_ac_wan lan_ac_ts wan_ac_ts; do
			uci -q delete "firewall.$section"
		done
		return 0
	fi

	uci -q batch <<-EOF || fail "Failed to configure the Tailscale firewall zone."
		set firewall.tszone='zone'
		set firewall.tszone.name='tailscale'
		set firewall.tszone.network='tailscale'
		set firewall.tszone.input='ACCEPT'
		set firewall.tszone.output='ACCEPT'
		set firewall.tszone.forward='ACCEPT'
		set firewall.tszone.masq='1'
		set firewall.tszone.mtu_fix='1'
	EOF
	has_access ts_ac_lan && add_forwarding ts_ac_lan tailscale lan
	has_access ts_ac_lan || uci -q delete firewall.ts_ac_lan
	has_access ts_ac_wan && add_forwarding ts_ac_wan tailscale wan
	has_access ts_ac_wan || uci -q delete firewall.ts_ac_wan
	has_access lan_ac_ts && add_forwarding lan_ac_ts lan tailscale
	has_access lan_ac_ts || uci -q delete firewall.lan_ac_ts
	has_access wan_ac_ts && add_forwarding wan_ac_ts wan tailscale
	has_access wan_ac_ts || uci -q delete firewall.wan_ac_ts
}

commit_openwrt_changes() {
	if [ -n "$(uci changes dhcp)" ]; then
		uci commit dhcp || fail "Failed to commit DHCP configuration."
		/etc/init.d/dnsmasq reload || fail "Failed to reload dnsmasq."
	fi
	if [ -n "$(uci changes network)" ]; then
		uci commit network || fail "Failed to commit network configuration."
		/etc/init.d/network reload || fail "Failed to reload network configuration."
	fi
	if [ -n "$(uci changes firewall)" ]; then
		uci commit firewall || fail "Failed to commit firewall configuration."
		/etc/init.d/firewall reload || fail "Failed to reload firewall configuration."
	fi
}

sync_all() {
	local state

	load_settings
	state="$(wait_for_localapi)" || fail "Tailscale LocalAPI did not become ready."
	login_if_needed "$state"
	state="$(wait_for_localapi)" || fail "Tailscale did not become ready after login."
	[ "$state" = "Running" ] || {
		[ "$state" = "NeedsMachineAuth" ] && fail "This node is waiting for machine approval."
		fail "Tailscale backend is not running (state: $state)."
	}
	sync_preferences
	configure_magicdns
	configure_network
	configure_firewall
	commit_openwrt_changes
}

sync_openwrt() {
	local state

	load_settings
	state="$(wait_for_localapi)" || fail "Tailscale LocalAPI did not become ready."
	[ "$state" = "Running" ] || fail "Tailscale backend is not running (state: $state)."
	configure_magicdns
	configure_network
	configure_firewall
	commit_openwrt_changes
}

[ "${TAILSCALE_HELPER_LIBRARY_ONLY:-0}" = "1" ] && return 0

mkdir -p "${LOCK_FILE%/*}"
exec 9>"$LOCK_FILE"
flock -xn 9 || fail "Another Tailscale configuration sync is already running."

case "${1:-sync}" in
	sync) sync_all ;;
	network) sync_openwrt ;;
	*) fail "Unknown action: $1" ;;
esac
