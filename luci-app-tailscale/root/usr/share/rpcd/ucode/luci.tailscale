'use strict';

import { popen } from 'fs';

const TAILSCALE = '/usr/sbin/tailscale';
const MAX_OUTPUT = 256 * 1024;

function shellquote(value) {
	return "'" + replace(`${value}`, "'", "'\\''") + "'";
}

function execute(args, keep_stderr) {
	let command = join(' ', map(args, shellquote));
	command += keep_stderr ? ' 2>&1' : ' 2>/dev/null';

	const fd = popen(command);
	if (!fd)
		return { code: 126, output: '', error: 'failed to execute command' };

	let output = fd.read('all') || '';
	const code = fd.close();
	let truncated = false;
	if (length(output) > MAX_OUTPUT) {
		output = substr(output, 0, MAX_OUTPUT);
		truncated = true;
	}

	return { code, output, truncated };
}

function parse_json(result) {
	if (result.code !== 0 || !result.output)
		return null;
	try {
		return json(result.output);
	} catch (e) {
		return null;
	}
}

function valid_target(value) {
	return type(value) === 'string' && length(value) > 0 && length(value) <= 253 &&
		match(value, /^[A-Za-z0-9_.:%-]+$/);
}

function valid_dns_name(value) {
	return type(value) === 'string' && length(value) > 0 && length(value) <= 253 &&
		match(value, /^[A-Za-z0-9_.:-]+$/);
}

const methods = {
	summary: {
		call: function() {
			const status_result = execute([ TAILSCALE, 'status', '--json' ], false);
			const prefs_result = execute([ TAILSCALE, 'debug', 'prefs' ], false);
			return {
				status: parse_json(status_result),
				prefs: parse_json(prefs_result),
				code: status_result.code,
				prefs_code: prefs_result.code
			};
		}
	},

	status: {
		call: function() {
			const status_result = execute([ TAILSCALE, 'status', '--json' ], false);
			const prefs_result = execute([ TAILSCALE, 'debug', 'prefs' ], false);
			const interface_result = execute([ '/sbin/ip', '-s', '-j', 'addr', 'show' ], false);
			const appc_result = execute([ TAILSCALE, 'appc-routes', '--all' ], true);

			return {
				status: parse_json(status_result),
				prefs: parse_json(prefs_result),
				interfaces: parse_json(interface_result) || [],
				app_connector: appc_result.output,
				errors: {
					status: status_result.code,
					prefs: prefs_result.code,
					interfaces: interface_result.code,
					app_connector: appc_result.code
				}
			};
		}
	},

	diagnostic: {
		args: { tool: 'tool', target: 'target', qtype: 'qtype' },
		call: function(request) {
			const tool = request.args?.tool;
			const target = request.args?.target;
			const qtype = uc(request.args?.qtype || 'A');
			let args;

			switch (tool) {
			case 'netcheck':
				args = [ TAILSCALE, 'netcheck' ];
				break;
			case 'ping':
				if (!valid_target(target))
					return { code: 2, output: '', error: 'invalid ping target' };
				args = [ TAILSCALE, 'ping', '--c=5', '--timeout=5s', target ];
				break;
			case 'dns_status':
				args = [ TAILSCALE, 'dns', 'status', '--all' ];
				break;
			case 'dns_query':
				if (!valid_dns_name(target))
					return { code: 2, output: '', error: 'invalid DNS query name' };
				if (index([ 'A', 'AAAA', 'CNAME', 'MX', 'NS', 'PTR', 'SRV', 'TXT' ], qtype) === -1)
					return { code: 2, output: '', error: 'invalid DNS record type' };
				args = [ TAILSCALE, 'dns', 'query', target, qtype ];
				break;
			case 'exit_nodes':
				args = [ TAILSCALE, 'exit-node', 'list' ];
				break;
			case 'app_connector':
				args = [ TAILSCALE, 'appc-routes', '--all' ];
				break;
			case 'metrics':
				args = [ TAILSCALE, 'metrics', 'print' ];
				break;
			case 'bugreport':
				args = [ TAILSCALE, 'bugreport', '--diagnose' ];
				break;
			default:
				return { code: 2, output: '', error: 'unsupported diagnostic tool' };
			}

			return execute(args, true);
		}
	},

	logout: {
		call: function() {
			const result = execute([ TAILSCALE, 'logout' ], true);
			if (result.code === 0)
				system('(sleep 1; /usr/sbin/tailscale_helper sync) >/dev/null 2>&1 &');
			return result;
		}
	}
};

return { 'luci.tailscale': methods };
