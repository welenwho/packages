#!/bin/sh /etc/rc.common

START=90
STOP=10

USE_PROCD=1

PROG=/usr/sbin/tailscale_helper
PROGD=/usr/sbin/tailscaled
RUNTIME_DIR=/var/run/tailscale-luci
DAEMON_SIGNATURE="$RUNTIME_DIR/daemon.conf"

service_triggers() {
	procd_add_reload_trigger tailscale
}

section_enabled() {
	local enabled
	config_get_bool enabled "$1" enabled 0
	[ "$enabled" -gt 0 ]
}

normalize_wg_batch_size() {
	case "$1" in
		[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8]) printf '%s' "$1" ;;
	esac
	return 0
}

daemon_signature() {
	local cfg="$1" port config_path fw_mode wg_batch_size std_out std_err

	config_get port "$cfg" port 41641
	config_get config_path "$cfg" config_path /etc/tailscale
	config_get fw_mode "$cfg" fw_mode auto
	config_get wg_batch_size "$cfg" wg_batch_size
	wg_batch_size="$(normalize_wg_batch_size "$wg_batch_size")"
	config_get_bool std_out "$cfg" log_stdout 1
	config_get_bool std_err "$cfg" log_stderr 1
	printf 'port=%s\nconfig_path=%s\nfw_mode=%s\nwg_batch_size=%s\nstdout=%s\nstderr=%s\n' \
		"$port" "$config_path" "$fw_mode" "$wg_batch_size" "$std_out" "$std_err"
}

start_helper() {
	local cfg="$1" std_out std_err

	config_get_bool std_out "$cfg" log_stdout 1
	config_get_bool std_err "$cfg" log_stderr 1

	procd_open_instance sync
	procd_set_param command "$PROG" sync
	procd_set_param stdout "$std_out"
	procd_set_param stderr "$std_err"
	procd_set_param term_timeout 30
	procd_close_instance
}

start_instance() {
	local cfg="$1" port config_path fw_mode wg_batch_size std_out std_err state_file

	if ! section_enabled "$cfg"; then
		echo "disabled in /etc/config/tailscale"
		return 0
	fi

	config_get port "$cfg" port 41641
	config_get config_path "$cfg" config_path /etc/tailscale
	config_get fw_mode "$cfg" fw_mode auto
	config_get wg_batch_size "$cfg" wg_batch_size
	wg_batch_size="$(normalize_wg_batch_size "$wg_batch_size")"
	config_get_bool std_out "$cfg" log_stdout 1
	config_get_bool std_err "$cfg" log_stderr 1

	case "$fw_mode" in
		auto|nftables|iptables) ;;
		*) fw_mode=auto ;;
	esac
	[ -n "$config_path" ] || config_path=/etc/tailscale
	mkdir -p "$config_path" "$RUNTIME_DIR"
	state_file="$config_path/tailscaled.state"
	daemon_signature "$cfg" >"$DAEMON_SIGNATURE"

	procd_open_instance daemon
	procd_set_param command "$PROGD"
	[ -n "$port" ] && procd_append_param command --port "$port"
	procd_append_param command --state "$state_file"
	if [ -n "$wg_batch_size" ]; then
		procd_set_param env "TS_DEBUG_FIREWALL_MODE=$fw_mode" \
			"TS_DEBUG_WG_BATCH_SIZE=$wg_batch_size"
	else
		procd_set_param env "TS_DEBUG_FIREWALL_MODE=$fw_mode"
	fi
	procd_set_param respawn
	procd_set_param stdout "$std_out"
	procd_set_param stderr "$std_err"
	procd_set_param term_timeout 30
	procd_close_instance

	start_helper "$cfg"
}

start_service() {
	config_load tailscale
	config_foreach start_instance tailscale
}

remove_openwrt_integration() {
	local domain field option rebind rebind_option suffix route section

	for field in address server; do
		for option in $(uci show dhcp 2>/dev/null | sed -n "s/^\([^=]*\.$field\)=.*\/100\.100\.100\.100'.*/\1/p"); do
			for suffix in $(uci -q get "$option" 2>/dev/null); do
				case "$suffix" in
					/*/100.100.100.100)
						uci -q del_list "$option=$suffix"
						domain="${suffix#/}"
						domain="${domain%/100.100.100.100}"
						rebind="/$domain/"
						for rebind_option in $(uci show dhcp 2>/dev/null | sed -n "s/^\([^=]*\.rebind_domain\)=.*/\1/p"); do
							uci -q del_list "$rebind_option=$rebind"
						done
						;;
				esac
			done
		done
	done

	uci -q delete network.tailscale
	uci -q delete network.ts_lan
	for route in $(uci show network 2>/dev/null | sed -n "s/^\(network\.ts_subnet[0-9][0-9]*\)=route$/\1/p"); do
		uci -q delete "$route"
	done

	for section in tszone ts_ac_lan ts_ac_wan lan_ac_ts wan_ac_ts; do
		uci -q delete "firewall.$section"
	done

	[ -n "$(uci changes dhcp)" ] && uci commit dhcp && /etc/init.d/dnsmasq reload
	[ -n "$(uci changes network)" ] && uci commit network && /etc/init.d/network reload
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload
}

stop_service() {
	remove_openwrt_integration
	"$PROGD" --cleanup >/dev/null 2>&1
	rm -f "$DAEMON_SIGNATURE"
}

reload_service() {
	local enabled current desired

	config_load tailscale
	config_get_bool enabled settings enabled 0
	if [ "$enabled" != "1" ]; then
		stop
		return
	fi

	desired="$(daemon_signature settings)"
	current="$(cat "$DAEMON_SIGNATURE" 2>/dev/null)"
	if pidof tailscaled >/dev/null 2>&1 && [ "$current" = "$desired" ]; then
		"$PROG" sync
	else
		restart
	fi
}
