#!/bin/sh

tailscale_enable="$(uci -q get tailscale.settings.enabled)"

[ "$ACTION" = ifup -o "$ACTION" = ifupdate ] || exit 0
[ "$ACTION" = ifupdate -a -z "$IFUPDATE_ADDRESSES" -a -z "$IFUPDATE_DATA" ] && exit 0
# Never re-enter synchronization from tailscale0 itself.
[ "$INTERFACE" = "tailscale" ] && exit 0
[ "$tailscale_enable" = "1" ] || exit 0
pidof tailscaled >/dev/null 2>&1 || exit 0
/usr/sbin/tailscale_helper network >/dev/null 2>&1 &
