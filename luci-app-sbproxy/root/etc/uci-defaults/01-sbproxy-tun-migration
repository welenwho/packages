#!/bin/sh
# One-time removal of policy routing owned by an old SBProxy TProxy instance.
# Never flush a shared routing table or alter the Tailscale table/rules.
if [ "$(uci -q get sbproxy.config.proxy_mode)" = tproxy ] &&
   grep -q '"tproxy-in"' /var/run/sbproxy/sing-box-c.json 2>/dev/null; then
	legacy_table="$(uci -q get sbproxy.infra.table_mark)"
	legacy_mark="$(uci -q get sbproxy.infra.tproxy_mark)"
	legacy_table="${legacy_table:-100}"
	legacy_mark="${legacy_mark:-101}"
	case "$legacy_table" in ''|*[!0-9]*|0|52|253|254|255) exit 0;; esac
	printf '%s\n' "$legacy_mark" | grep -Eq '^(0x[0-9a-fA-F]+|[0-9]+)$' || exit 0
	for family in -4 -6; do
		while ip "$family" rule del fwmark "$legacy_mark" table "$legacy_table" 2>/dev/null; do :; done
	done
	ip -4 route del local 0.0.0.0/0 dev lo table "$legacy_table" 2>/dev/null || true
	ip -6 route del local ::/0 dev lo table "$legacy_table" 2>/dev/null || true
fi
exit 0
