#!/bin/sh

dashboard_port="$(uci -q get sbproxy.config.dashboard_port)"
dashboard_port_initialized="$(uci -q get sbproxy.config.dashboard_port_initialized)"
clash_api_port="$(uci -q get sbproxy.infra.clash_api_port)"
clash_api_port_initialized="$(uci -q get sbproxy.infra.clash_api_port_initialized)"
tailscale_api_port="$(uci -q get sbproxy.infra.tailscale_api_port)"
tailscale_api_port_initialized="$(uci -q get sbproxy.infra.tailscale_api_port_initialized)"
main_node="$(uci -q get sbproxy.config.main_node)"
dashboard_enabled="$(uci -q get sbproxy.config.dashboard_enabled)"
changed=0

mkdir -p /var/run/sbproxy

log() {
	printf '%s [DAEMON] %s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$*" >> /var/run/sbproxy/sbproxy.log
}

random_port() {
	/usr/libexec/sbproxy-random-port "$@"
}

valid_port() {
	case "$1" in
	''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

initialize_port() {
	local port="$1" default_port="$2" initialized="$3"
	shift 3

	if ! valid_port "$port" || { [ "$port" = "$default_port" ] && [ "$initialized" != '1' ]; }; then
		port="$(random_port "$@")"
	fi
	printf '%s\n' "$port"
}

sing_box_version="$(/usr/bin/sing-box version -n 2>/dev/null)"
sing_box_major="${sing_box_version%%.*}"
sing_box_minor="${sing_box_version#*.}"
sing_box_minor="${sing_box_minor%%.*}"
case "$sing_box_major:$sing_box_minor" in
*[!0-9:]*|:*)
	log "SBProxy requires sing-box 1.14 or newer."
	exit 1
	;;
esac
if [ "$sing_box_major" -lt 1 ] || \
   { [ "$sing_box_major" -eq 1 ] && [ "$sing_box_minor" -lt 14 ]; }; then
	log "SBProxy requires sing-box 1.14 or newer; found $sing_box_version."
	exit 1
fi

clash_api_port="$(initialize_port "$clash_api_port" 9090 "$clash_api_port_initialized" "$dashboard_port")"
dashboard_port="$(initialize_port "$dashboard_port" 9095 "$dashboard_port_initialized" "$clash_api_port")"
tailscale_api_port="$(initialize_port "$tailscale_api_port" 9096 "$tailscale_api_port_initialized" \
	"$clash_api_port" "$dashboard_port")"
case "$tailscale_api_port" in
"$clash_api_port"|"$dashboard_port")
	tailscale_api_port="$(random_port "$clash_api_port" "$dashboard_port")"
	;;
esac

if [ "$main_node" = 'urltest' ] && [ "$dashboard_enabled" = '1' ] && \
   [ "$clash_api_port" = "$dashboard_port" ]; then
	dashboard_port="$(random_port "$clash_api_port" "$tailscale_api_port")"
fi

if [ "$(uci -q get sbproxy.infra.clash_api_port)" != "$clash_api_port" ]; then
	uci -q set sbproxy.infra.clash_api_port="$clash_api_port"
	changed=1
fi
if [ "$(uci -q get sbproxy.config.dashboard_port)" != "$dashboard_port" ]; then
	uci -q set sbproxy.config.dashboard_port="$dashboard_port"
	changed=1
fi
if [ "$(uci -q get sbproxy.infra.tailscale_api_port)" != "$tailscale_api_port" ]; then
	uci -q set sbproxy.infra.tailscale_api_port="$tailscale_api_port"
	changed=1
fi
if [ "$clash_api_port_initialized" != '1' ]; then
	uci -q set sbproxy.infra.clash_api_port_initialized='1'
	changed=1
fi
if [ "$dashboard_port_initialized" != '1' ]; then
	uci -q set sbproxy.config.dashboard_port_initialized='1'
	changed=1
fi
if [ "$tailscale_api_port_initialized" != '1' ]; then
	uci -q set sbproxy.infra.tailscale_api_port_initialized='1'
	changed=1
fi

if [ "$(uci -q get sbproxy.control.ingress_enabled)" = '1' ] &&
   [ -n "$(uci -q get sbproxy.control.ingress_bypass_devices)$(uci -q get sbproxy.control.ingress_bypass_wifi)" ]; then
	ingress_dns_port="$(uci -q get sbproxy.infra.ingress_dns_port)"
	ingress_reserved="$clash_api_port $dashboard_port $tailscale_api_port $(uci -q get sbproxy.infra.dns_port) $(uci -q get sbproxy.infra.mixed_port) 53"
	for reserved in $ingress_reserved; do
		[ "$ingress_dns_port" != "$reserved" ] || ingress_dns_port=auto
	done
	if ! valid_port "$ingress_dns_port"; then
		ingress_dns_port="$(random_port $ingress_reserved)"
	fi
	if [ "$(uci -q get sbproxy.infra.ingress_dns_port)" != "$ingress_dns_port" ]; then
		uci -q set sbproxy.infra.ingress_dns_port="$ingress_dns_port"
		changed=1
	fi
fi

[ "$changed" -eq 0 ] || uci -q commit sbproxy
exit 0
