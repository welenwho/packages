{
	"luci-app-sbproxy": {
		"description": "Grant access to SBProxy configuration",
		"read": {
			"file": {
				"/var/run/sbproxy/sbproxy.log": [ "read" ],
				"/var/run/sbproxy/sing-box-c.log": [ "read" ],
				"/var/run/sbproxy/sing-box-s.log": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"luci-rpc": [ "getHostHints" ],
				"luci.sbproxy": [
					"acllist_read", "adaptive_status", "connection_check", "current_node_get",
					"node_latency_test", "resources_get", "tailscale_status",
					"singbox_generator", "singbox_get_features"
				]
			},
			"uci": [ "sbproxy", "sbproxy-adaptive", "tailscale" ]
		},
		"write": {
			"file": {
				"/etc/sbproxy/scripts/update_subscriptions.sh": [ "exec" ],
				"/tmp/sbproxy_certificate.tmp": [ "write" ]
			},
			"ubus": {
				"luci.sbproxy": [
					"acllist_write", "adaptive_clear", "adaptive_remove", "certificate_write", "log_clean", "resources_update",
					"tailscale_logout", "tailscale_ping"
				]
			},
			"uci": [ "sbproxy", "sbproxy-adaptive" ]
		}
	}
}
