config adaptive 'main'
	option enabled '0'
	option dry_run '1'
	option allow_global '0'
	option outbound ''
	option candidate_trigger 'slow_or_failure'
	option poll_interval '15'
	option slow_seconds '10'
	option slow_bytes '65536'
	option min_observations '2'
	option probe_interval '60'
	option probe_timeout '5000'
	option probe_samples '2'
	option baseline_slow_ms '1200'
	option min_improvement_ms '300'
	option min_improvement_percent '40'
	option max_rules '100'
	option max_ip_rules '20'
	option max_load '2'
	option direct_probe_port 'auto'
	option direct_probe_port_initialized '0'
	option proxy_probe_port 'auto'
	option proxy_probe_port_initialized '0'
	list exclude_suffix 'lan'
	list exclude_suffix 'local'
	list exclude_suffix 'localhost'
	list exclude_suffix 'localdomain'
	list exclude_suffix 'home.arpa'
	list exclude_suffix 'internal'
