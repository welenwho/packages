#!/bin/sh

# SPDX-License-Identifier: GPL-3.0-only

FUNCTIONS_LIB="${SBPROXY_FUNCTIONS_LIB:-/lib/functions.sh}"
. "$FUNCTIONS_LIB"

SING_BOX_BIN="${SBPROXY_SING_BOX_BIN:-/usr/bin/sing-box}"
IP_BIN="${SBPROXY_IP_BIN:-/sbin/ip}"
STATE_FILE="${SBPROXY_TAILSCALE_MAGICDNS_STATE:-/etc/sbproxy/tailscale/magicdns_target}"
ROUTE_STATE_FILE="${SBPROXY_TAILSCALE_ROUTE_STATE:-/var/run/sbproxy/tailscale_routes}"
NAT_FILE="${SBPROXY_TAILSCALE_NAT_FILE:-/var/run/sbproxy/fw4_tailscale.nft}"
STANDALONE_INIT="${SBPROXY_TAILSCALE_STANDALONE_INIT:-/etc/init.d/tailscale}"
NETIFD_PROTO="${SBPROXY_TAILSCALE_NETIFD_PROTO:-/lib/netifd/proto/sbproxy_tailscale.sh}"
SYS_CLASS_NET="${SBPROXY_SYS_CLASS_NET:-/sys/class/net}"
SYNC_LOCK="${SBPROXY_TAILSCALE_SYNC_LOCK:-/var/lock/sbproxy-tailscale-sync}"
STOP_FILE="${SBPROXY_TAILSCALE_STOP_FILE:-/var/run/sbproxy/tailscale.stopping}"
LOG_TAG="sbproxy-tailscale"
FIREWALL_RUNTIME_CHANGED=0

log_info() {
	logger -p daemon.info -t "$LOG_TAG" "$*"
}

log_error() {
	logger -p daemon.err -t "$LOG_TAG" "$*"
}

fail() {
	log_error "$*"
	exit 1
}

load_settings() {
	local cfg="tailscale" dashboard_enabled dashboard_port dashboard_path

	config_load sbproxy
	config_get_bool ENABLED "$cfg" enabled 0
	config_get STATE_DIRECTORY "$cfg" state_directory /etc/sbproxy/tailscale
	config_get INTERFACE_NAME "$cfg" system_interface_name tailscale0
	config_get DNS_PORT infra dns_port 5333
	config_get API_PORT infra tailscale_api_port
	config_get dashboard_port config dashboard_port
	config_get_bool dashboard_enabled config dashboard_enabled 0
	config_get_bool MAGIC_DNS "$cfg" magic_dns 1
	config_get_bool ACCEPT_ROUTES "$cfg" accept_routes 0
	config_get SUBNET_ROUTES "$cfg" subnet_routes
	config_get ACCESS "$cfg" access
	config_get_bool DISABLE_SNAT "$cfg" disable_snat_subnet_routes 0
	config_get_bool ADVERTISE_EXIT_NODE "$cfg" advertise_exit_node 0
	config_get EXIT_NODE "$cfg" exit_node
	config_get API_SECRET config dashboard_secret

	dashboard_path="/etc/sbproxy/dashboard/index.html"
	[ "$dashboard_enabled" = "1" ] && [ -s "$dashboard_path" ] && API_PORT="$dashboard_port"
	[ "$ACCEPT_ROUTES" = "1" ] || SUBNET_ROUTES=''
	API_URL="http://127.0.0.1:$API_PORT"
}

validate_settings() {
	case "$INTERFACE_NAME" in
		''|*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	case "$API_PORT" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$API_PORT" -ge 1 ] 2>"/dev/null" && [ "$API_PORT" -le 65535 ] 2>"/dev/null" || return 1
	[ "$ADVERTISE_EXIT_NODE" != "1" ] || [ "$DISABLE_SNAT" != "1" ] || return 1
	[ "$ADVERTISE_EXIT_NODE" != "1" ] || [ -z "$EXIT_NODE" ] || return 1
	return 0
}

api() {
	BOX_API_URL="$API_URL" BOX_API_SECRET="$API_SECRET" "$SING_BOX_BIN" api "$@"
}

status_output() {
	api tailscale status 2>"/dev/null"
}

uci_get() {
	uci -q get "$1" 2>"/dev/null"
}

uci_set_if_changed() {
	local key="$1" value="$2"

	[ "$(uci_get "$key")" = "$value" ] || uci -q set "$key=$value"
}

uci_delete_if_exists() {
	uci_get "$1" >"/dev/null" || return 0
	uci -q delete "$1"
}

uci_list_has() {
	uci_get "$1" | tr ' ' '\n' | grep -qxF "$2"
}

uci_replace_list() {
	local key="$1" values="$2" value

	[ "$(uci_get "$key")" = "$values" ] && return 0
	uci_delete_if_exists "$key" || return 1
	for value in $values; do
		uci -q add_list "$key=$value" || return 1
	done
}

write_if_changed() {
	local path="$1" content="$2" temporary

	mkdir -p "${path%/*}" || return 2
	temporary="${path}.new"
	printf '%s' "$content" > "$temporary" || return 2
	if [ -f "$path" ] && cmp -s "$temporary" "$path"; then
		rm -f "$temporary"
		return 1
	fi
	mv -f "$temporary" "$path" || return 2
	return 0
}

backend_state() {
	status_output | sed -n 's/^[[:space:]]*State:[[:space:]]*//p' | head -n 1
}

auth_url() {
	status_output | sed -n 's/^[[:space:]]*Log in:[[:space:]]*//p' | head -n 1
}

standalone_conflict() {
	local standalone_enabled

	if [ -x "$STANDALONE_INIT" ]; then
		standalone_enabled="$(uci -q get tailscale.settings.enabled)"
		[ "$standalone_enabled" != "1" ] || return 0
	fi
	pidof tailscaled >"/dev/null" 2>&1 && return 0
	return 1
}

self_details() {
	local first_line self_name self_ip details ips address

	first_line="$(api tailscale peer list 2>"/dev/null" | head -n 1)"
	self_name="$(printf '%s\n' "$first_line" | awk '{ print $1 }')"
	self_ip="$(printf '%s\n' "$first_line" | awk '{ print $2 }')"
	[ -n "$self_name" ] && [ -n "$self_ip" ] || return 1

	details="$(api tailscale peer show "$self_ip" 2>"/dev/null")"
	ips="$(printf '%s\n' "$details" | sed -n 's/^[[:space:]]*IPs:[[:space:]]*//p' | head -n 1)"
	[ -n "$ips" ] || return 1

	TS_IPV4=''
	TS_IPV6=''
	for address in $(printf '%s' "$ips" | tr ',' ' '); do
		case "$address" in
			*.*) [ -n "$TS_IPV4" ] || TS_IPV4="$address" ;;
			*:*) [ -n "$TS_IPV6" ] || TS_IPV6="$address" ;;
		esac
	done
	[ -n "$TS_IPV4" ] || return 1

	TS_DNS_NAME="$self_name"
	case "$self_name" in
		*.*) TS_DNS_SUFFIX="${self_name#*.}" ;;
		*) TS_DNS_SUFFIX='' ;;
	esac
	return 0
}

system_interface_ready() {
	local addresses routes carrier_path

	[ -d "$SYS_CLASS_NET/$INTERFACE_NAME" ] || return 1
	# A Tailscale TUN can keep its device node, address and routes while the
	# underlying endpoint is temporarily stopped. Treat a down carrier as not
	# ready so the next recovery can rebind consumers such as Dropbear.
	carrier_path="$SYS_CLASS_NET/$INTERFACE_NAME/carrier"
	if [ -r "$carrier_path" ]; then
		[ "$(cat "$carrier_path" 2>"/dev/null")" = "1" ] || return 1
	fi
	addresses="$("$IP_BIN" -4 address show dev "$INTERFACE_NAME" 2>"/dev/null")" || return 1
	printf '%s\n' "$addresses" | awk -v address="$TS_IPV4" '
		$1 == "inet" {
			split($2, parts, "/")
			if (parts[1] == address)
				found = 1
		}
		END { exit !found }
	' || return 1
	routes="$("$IP_BIN" -4 route show table 52 2>"/dev/null")" || return 1
	printf '%s\n' "$routes" | grep -Fq "dev $INTERFACE_NAME"
}

trigger_urltests() {
	local tab

	tab="$(printf '\t')"
	api group list 2>"/dev/null" |
		while IFS="$tab" read -r group type selected; do
			[ "$type" = "urltest" ] || continue
			api group urltest "$group" >"/dev/null" 2>&1 || true
		done
}

remove_magicdns_target() {
	local target="$1" domain option index

	[ -n "$target" ] || return 0
	domain="${target#/}"
	domain="${domain%%/*}"
	index="$(uci show dhcp 2>"/dev/null" | sed -n "s/^dhcp\.@dnsmasq\[\([0-9][0-9]*\)\]=dnsmasq$/\1/p")"
	for option in $index; do
		if uci_list_has "dhcp.@dnsmasq[$option].server" "$target"; then
			uci -q del_list "dhcp.@dnsmasq[$option].server=$target" || return 1
		fi
		if uci_list_has "dhcp.@dnsmasq[$option].rebind_domain" "/$domain/"; then
			uci -q del_list "dhcp.@dnsmasq[$option].rebind_domain=/$domain/" || return 1
		fi
	done
}

configure_magicdns() {
	local previous target='' index option

	previous="$(cat "$STATE_FILE" 2>"/dev/null")"
	if [ "$MAGIC_DNS" = "1" ] && [ -n "$TS_DNS_SUFFIX" ]; then
		target="/$TS_DNS_SUFFIX/127.0.0.1#$DNS_PORT"
	fi
	if [ "$previous" != "$target" ]; then
		remove_magicdns_target "$previous"
		rm -f "$STATE_FILE"
	fi
	[ -n "$target" ] || return 0

	index="$(uci show dhcp 2>"/dev/null" | sed -n "s/^dhcp\.@dnsmasq\[\([0-9][0-9]*\)\]=dnsmasq$/\1/p")"
	for option in $index; do
		uci_list_has "dhcp.@dnsmasq[$option].server" "$target" ||
			uci -q add_list "dhcp.@dnsmasq[$option].server=$target" || return 1
		uci_list_has "dhcp.@dnsmasq[$option].rebind_domain" "/$TS_DNS_SUFFIX/" ||
			uci -q add_list "dhcp.@dnsmasq[$option].rebind_domain=/$TS_DNS_SUFFIX/" || return 1
	done
	mkdir -p "${STATE_FILE%/*}" || return 1
	[ "$previous" = "$target" ] && [ -f "$STATE_FILE" ] ||
		printf '%s\n' "$target" > "$STATE_FILE" || return 1
}

route_command() {
	local route="$1"
	shift
	case "$route" in
		*:*) "$IP_BIN" -6 route "$@" ;;
		*) "$IP_BIN" -4 route "$@" ;;
	esac
}

rule_command() {
	local route="$1"
	shift
	case "$route" in
		*:*) "$IP_BIN" -6 rule "$@" ;;
		*) "$IP_BIN" -4 rule "$@" ;;
	esac
}

remove_managed_route() {
	local route="$1"
	route_command "$route" del "$route" dev "$INTERFACE_NAME" 2>"/dev/null" || true
}

route_conflict() {
	local route="$1" routes

	routes="$(route_command "$route" show match "$route" 2>"/dev/null" || true)"
	printf '%s\n' "$routes" | awk -v interface="$INTERFACE_NAME" '
		$1 == "default" { next }
		{
			owned = 0
			for (i = 1; i < NF; i++)
				if ($i == "dev" && $(i + 1) == interface)
					owned = 1
			if (!owned)
				print
		}
	'
}

find_tailscale_rule_priority() {
	local family="$1"

	"$IP_BIN" "$family" rule show 2>"/dev/null" | awk '
		$2 == "from" && $3 == "all" && $4 == "lookup" && $5 == "52" {
			gsub(/:$/, "", $1)
			print $1
			exit
		}
	'
}

find_resume_rule_priority() {
	local family="$1" tailscale_priority="$2"

	"$IP_BIN" "$family" rule show 2>"/dev/null" | awk -v priority="$tailscale_priority" '
		{
			current = $1
			gsub(/:$/, "", current)
			if (current ~ /^[0-9]+$/ && (current + 0) > (priority + 0)) {
				print current
				exit
			}
		}
	'
}

remove_policy_rule() {
	local route="$1" priority="$2"
	rule_command "$route" del priority "$priority" to "$route" table 52 2>"/dev/null" || true
}

remove_policy_control() {
	local route="$1" priority="$2" resume_priority="$3" skip_priority

	[ -n "$priority" ] && [ -n "$resume_priority" ] || return 0
	skip_priority=$((priority - 1))
	rule_command "$route" del priority "$skip_priority" goto "$resume_priority" 2>"/dev/null" || true
}

ensure_policy_rule() {
	local route="$1" priority="$2" current

	current="$(rule_command "$route" show priority "$priority" 2>"/dev/null" || true)"
	printf '%s\n' "$current" | grep -Fq "to $route lookup 52" && return 0
	rule_command "$route" add priority "$priority" to "$route" table 52
}

ensure_policy_control() {
	local route="$1" priority="$2" resume_priority="$3" skip_priority current

	skip_priority=$((priority - 1))
	current="$(rule_command "$route" show priority "$skip_priority" 2>"/dev/null" || true)"
	printf '%s\n' "$current" | grep -Fq "goto $resume_priority" && return 0
	if [ -n "$current" ]; then
		log_error "Policy rule priority $skip_priority is already occupied: $current"
		return 1
	fi
	rule_command "$route" add priority "$skip_priority" goto "$resume_priority"
}

cleanup_route_policy() {
	local priority4 priority6 resume4 resume6 routes route priority

	priority4="$(sed -n 's/^priority4=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	priority6="$(sed -n 's/^priority6=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	resume4="$(sed -n 's/^resume4=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	resume6="$(sed -n 's/^resume6=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	routes="$(sed '/^\(priority[46]\|resume[46]\)=/d' "$ROUTE_STATE_FILE" 2>"/dev/null" || true)"
	if [ -n "$priority4" ] || [ -n "$priority6" ]; then
		for route in $routes; do
			case "$route" in
				*:*) priority="$priority6" ;;
				*) priority="$priority4" ;;
			esac
			[ -z "$priority" ] || remove_policy_rule "$route" "$((priority - 10))"
		done
		remove_policy_control 0.0.0.0/0 "$priority4" "$resume4"
		remove_policy_control ::/0 "$priority6" "$resume6"
	else
		# Release 4 installed selected routes directly into the main table.
		for route in $routes; do
			remove_managed_route "$route"
		done
	fi
	rm -f "$ROUTE_STATE_FILE"
}

configure_route_policy() {
	local previous_priority4 previous_priority6 previous_resume4 previous_resume6
	local previous desired installed='' state_content route conflict
	local priority4 priority6 resume4 resume6 priority select_priority write_status

	previous_priority4="$(sed -n 's/^priority4=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	previous_priority6="$(sed -n 's/^priority6=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	previous_resume4="$(sed -n 's/^resume4=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	previous_resume6="$(sed -n 's/^resume6=//p' "$ROUTE_STATE_FILE" 2>"/dev/null" | head -n 1)"
	previous="$(sed '/^\(priority[46]\|resume[46]\)=/d' "$ROUTE_STATE_FILE" 2>"/dev/null" || true)"
	if [ "$ACCEPT_ROUTES" != "1" ] || [ -n "$EXIT_NODE" ]; then
		cleanup_route_policy
		return 0
	fi

	priority4="$(find_tailscale_rule_priority -4)"
	priority6="$(find_tailscale_rule_priority -6)"
	case "$priority4" in
		''|*[!0-9]*)
			log_error "Tailscale IPv4 policy routing rule is unavailable; refusing to install selected subnet rules."
			return 1
			;;
	esac
	case "$priority6" in
		''|*[!0-9]*) priority6='' ;;
	esac
	resume4="$(find_resume_rule_priority -4 "$priority4")"
	[ -n "$priority6" ] && resume6="$(find_resume_rule_priority -6 "$priority6")"
	if [ -z "$resume4" ] || { [ -n "$priority6" ] && [ -z "$resume6" ]; }; then
		log_error "No policy rule is available after the Tailscale catch-all rule."
		return 1
	fi
	if { [ -n "$previous_priority4" ] || [ -n "$previous_priority6" ]; } &&
	   { [ "$previous_priority4" != "$priority4" ] ||
	     [ "$previous_priority6" != "$priority6" ] ||
	     [ "$previous_resume4" != "$resume4" ] ||
	     [ "$previous_resume6" != "$resume6" ]; }; then
		cleanup_route_policy
		previous=''
	elif [ -z "$previous_priority4" ] && [ -z "$previous_priority6" ] && [ -n "$previous" ]; then
		# Migrate routes managed directly by release 4.
		for route in $previous; do
			remove_managed_route "$route"
		done
		previous=''
	fi

	desired='100.64.0.0/10'
	[ -z "$TS_IPV6" ] || [ -z "$priority6" ] || desired="$desired fd7a:115c:a1e0::/48"
	desired="$desired $SUBNET_ROUTES"
	for route in $previous; do
		case " $desired " in
			*" $route "*) ;;
			*)
				case "$route" in
					*:*) priority="$previous_priority6" ;;
					*) priority="$previous_priority4" ;;
				esac
				[ -z "$priority" ] || remove_policy_rule "$route" "$((priority - 10))"
				;;
		esac
	done
	for route in $desired; do
		case "$route" in
			*:*) priority="$priority6" ;;
			*) priority="$priority4" ;;
		esac
		if [ -z "$priority" ]; then
			log_error "Skipping peer route $route because its address family has no Tailscale policy rule."
			continue
		fi
		select_priority=$((priority - 10))
		case "$route" in
			0.0.0.0/0|::/0)
				log_error "Skipping default peer route $route; configure it as an exit node instead."
				remove_policy_rule "$route" "$select_priority"
				continue
				;;
		esac
		conflict="$(route_conflict "$route")"
		if [ -n "$conflict" ]; then
			log_error "Skipping peer route $route because it overlaps an existing system route: $conflict"
			remove_policy_rule "$route" "$select_priority"
			continue
		fi
		ensure_policy_rule "$route" "$select_priority" || return 1
		installed="${installed}${installed:+ }$route"
	done
	ensure_policy_control 0.0.0.0/0 "$priority4" "$resume4" || return 1
	[ -z "$priority6" ] || ensure_policy_control ::/0 "$priority6" "$resume6" || return 1
	state_content="priority4=$priority4
priority6=$priority6
resume4=$resume4
resume6=$resume6
$installed
"
	if write_if_changed "$ROUTE_STATE_FILE" "$state_content"; then
		write_status=0
	else
		write_status=$?
	fi
	[ "$write_status" -lt 2 ]
}

configure_network() {
	local section

	uci_set_if_changed network.sbproxy_ts interface || return 1
	uci_set_if_changed network.sbproxy_ts.proto sbproxy_tailscale || return 1
	uci_set_if_changed network.sbproxy_ts.device "$INTERFACE_NAME" || return 1
	uci_set_if_changed network.sbproxy_ts.auto 1 || return 1
	uci_set_if_changed network.sbproxy_ts.ipaddr "$TS_IPV4" || return 1
	uci_delete_if_exists network.sbproxy_ts.netmask || return 1
	uci_replace_list network.sbproxy_ts.ip6addr "${TS_IPV6:+$TS_IPV6/128}" || return 1
	uci_delete_if_exists network.sbproxy_ts_ipv6 || return 1
	for section in $(uci show network 2>"/dev/null" |
		sed -n "s/^\(network\.sbproxy_ts_subnet[0-9][0-9]*\)=route$/\1/p"); do
		uci_delete_if_exists "$section" || return 1
	done
}

configure_dropbear() {
	local section

	for section in $(uci show dropbear 2>"/dev/null" |
		sed -n 's/^\(dropbear\.[^=]*\)=dropbear$/\1/p'); do
		[ "$(uci_get "$section.DirectInterface")" != "tailscale" ] ||
			uci_set_if_changed "$section.DirectInterface" sbproxy_ts || return 1
	done
}

dropbear_has_tailscale_binding() {
	local section direct_interface

	for section in $(uci show dropbear 2>"/dev/null" |
		sed -n 's/^\(dropbear\.[^=]*\)=dropbear$/\1/p'); do
		direct_interface="$(uci_get "$section.DirectInterface")"
		case "$direct_interface" in
			sbproxy_ts|tailscale|tailscale0) return 0 ;;
		esac
	done
	return 1
}

notify_network_status() {
	[ -x "$NETIFD_PROTO" ] || return 1
	"$NETIFD_PROTO" notify sbproxy_ts "$INTERFACE_NAME" "$TS_IPV4" "$TS_IPV6" 1
}

has_access() {
	case " $ACCESS " in
		*" $1 "*) return 0 ;;
		*) return 1 ;;
	esac
}

add_forwarding() {
	uci_set_if_changed "firewall.$1" forwarding || return 1
	uci_set_if_changed "firewall.$1.src" "$2" || return 1
	uci_set_if_changed "firewall.$1.dest" "$3" || return 1
}

configure_firewall() {
	local nat_content='' write_status

	uci_set_if_changed firewall.sbproxy_tszone zone || return 1
	uci_set_if_changed firewall.sbproxy_tszone.name sbproxy_tailscale || return 1
	uci_delete_if_exists firewall.sbproxy_tszone.network || return 1
	uci_set_if_changed firewall.sbproxy_tszone.device "$INTERFACE_NAME" || return 1
	uci_set_if_changed firewall.sbproxy_tszone.input ACCEPT || return 1
	uci_set_if_changed firewall.sbproxy_tszone.output ACCEPT || return 1
	uci_set_if_changed firewall.sbproxy_tszone.forward ACCEPT || return 1
	uci_set_if_changed firewall.sbproxy_tszone.masq 0 || return 1
	uci_set_if_changed firewall.sbproxy_tszone.mtu_fix 1 || return 1

	uci_set_if_changed firewall.sbproxy_ts_nat include || return 1
	uci_set_if_changed firewall.sbproxy_ts_nat.type nftables || return 1
	uci_set_if_changed firewall.sbproxy_ts_nat.path "$NAT_FILE" || return 1
	uci_set_if_changed firewall.sbproxy_ts_nat.position table-post || return 1
	if [ "$DISABLE_SNAT" != "1" ]; then
		nat_content="chain sbproxy_ts_postrouting {
	type nat hook postrouting priority srcnat + 1; policy accept;
	iifname \"$INTERFACE_NAME\" oifname != \"$INTERFACE_NAME\" masquerade comment \"!sbproxy: Tailscale forwarded traffic\"
}
"
	fi
	if write_if_changed "$NAT_FILE" "$nat_content"; then
		write_status=0
	else
		write_status=$?
	fi
	[ "$write_status" -ne 0 ] || FIREWALL_RUNTIME_CHANGED=1
	[ "$write_status" -lt 2 ] || return 1

	if has_access ts_ac_lan; then
		add_forwarding sbproxy_ts_ac_lan sbproxy_tailscale lan || return 1
	else
		uci_delete_if_exists firewall.sbproxy_ts_ac_lan || return 1
	fi
	if has_access ts_ac_wan; then
		add_forwarding sbproxy_ts_ac_wan sbproxy_tailscale wan || return 1
	else
		uci_delete_if_exists firewall.sbproxy_ts_ac_wan || return 1
	fi
	if has_access lan_ac_ts; then
		add_forwarding sbproxy_lan_ac_ts lan sbproxy_tailscale || return 1
	else
		uci_delete_if_exists firewall.sbproxy_lan_ac_ts || return 1
	fi
	if has_access wan_ac_ts; then
		add_forwarding sbproxy_wan_ac_ts wan sbproxy_tailscale || return 1
	else
		uci_delete_if_exists firewall.sbproxy_wan_ac_ts || return 1
	fi
}

commit_changes() {
	local dropbear_changes

	if [ -n "$(uci changes dhcp)" ]; then
		uci commit dhcp || return 1
		/etc/init.d/dnsmasq reload || return 1
	fi
	if [ -n "$(uci changes network)" ]; then
		uci commit network || return 1
		/etc/init.d/network reload || return 1
	fi
	if [ -n "$(uci changes firewall)" ]; then
		uci commit firewall || return 1
		/etc/init.d/firewall reload || return 1
	elif [ "$FIREWALL_RUNTIME_CHANGED" = "1" ]; then
		/etc/init.d/firewall reload || return 1
	fi
	dropbear_changes="$(uci changes dropbear)"
	if [ -n "$dropbear_changes" ]; then
		uci commit dropbear || return 1
		/etc/init.d/dropbear restart || return 1
	elif [ "${SBPROXY_TAILSCALE_RESTART_DROPBEAR:-0}" = "1" ] &&
		dropbear_has_tailscale_binding; then
		/etc/init.d/dropbear restart || return 1
	fi
	FIREWALL_RUNTIME_CHANGED=0
}

sync_openwrt() {
	self_details || return 2
	system_interface_ready || return 2
	configure_magicdns || return 1
	configure_network || return 1
	configure_dropbear || return 1
	configure_route_policy || return 1
	configure_firewall || return 1
	commit_changes || return 1
	notify_network_status
}

sync_openwrt_locked() {
	local result

	mkdir -p "${SYNC_LOCK%/*}" || return 1
	lock "$SYNC_LOCK" || return 1
	if [ -e "$STOP_FILE" ]; then
		result=2
	else
		sync_openwrt
		result=$?
	fi
	lock -u "$SYNC_LOCK"
	return "$result"
}

cleanup_openwrt() {
	local target section write_status

	target="$(cat "$STATE_FILE" 2>"/dev/null")"
	remove_magicdns_target "$target"
	rm -f "$STATE_FILE"
	cleanup_route_policy
	uci_delete_if_exists network.sbproxy_ts
	uci_delete_if_exists network.sbproxy_ts_ipv6
	for section in $(uci show network 2>"/dev/null" |
		sed -n "s/^\(network\.sbproxy_ts_subnet[0-9][0-9]*\)=route$/\1/p"); do
		uci_delete_if_exists "$section"
	done
	for section in sbproxy_tszone sbproxy_ts_ac_lan sbproxy_ts_ac_wan \
		sbproxy_lan_ac_ts sbproxy_wan_ac_ts sbproxy_ts_nat; do
		uci_delete_if_exists "firewall.$section"
	done
	if write_if_changed "$NAT_FILE" ''; then
		write_status=0
	else
		write_status=$?
	fi
	[ "$write_status" -ne 0 ] || FIREWALL_RUNTIME_CHANGED=1
	[ "$write_status" -lt 2 ] || return 1
	commit_changes
}

cleanup_openwrt_locked() {
	local result

	mkdir -p "${SYNC_LOCK%/*}" || return 1
	lock "$SYNC_LOCK" || return 1
	cleanup_openwrt
	result=$?
	lock -u "$SYNC_LOCK"
	return "$result"
}

watch_backend() {
	# The embedded endpoint may need a short moment to create tailscale0 and
	# install its policy rules. Retry at 1s intervals so switching to Tailscale
	# does not leave LuCI waiting for the old 2s polling cadence.
	local state url last_url='' delay=1 result integrated=0 waiting=0

	while [ "$ENABLED" = "1" ] && [ ! -e "$STOP_FILE" ]; do
		state="$(backend_state)"
		case "$state" in
			Running)
				# DirectInterface sockets are bound to the current TUN device. A
				# Tailscale restart can leave the old Dropbear listener alive but
				# unable to receive packets on the recovered interface. Force one
				# service restart whenever integration transitions back to ready;
				# subsequent 30s syncs remain idempotent.
				if [ "$integrated" = "0" ]; then
					SBPROXY_TAILSCALE_RESTART_DROPBEAR=1 sync_openwrt_locked
				else
					sync_openwrt_locked
				fi
				result=$?
				case "$result" in
					0)
						if [ "$integrated" = "0" ]; then
							trigger_urltests
							log_info "OpenWrt integration is ready; URLTest groups refreshed."
						fi
						integrated=1
						waiting=0
						delay=30
						;;
					2)
						[ -e "$STOP_FILE" ] && break
						if [ "$waiting" = "0" ]; then
							log_info "Waiting for the Tailscale system interface and routes."
						fi
						integrated=0
						waiting=1
						delay=1
						;;
					*)
						log_error "Failed to synchronize OpenWrt integration."
						integrated=0
						waiting=0
						delay=1
						;;
				esac
				;;
			NeedsLogin|NoState)
				integrated=0
				waiting=0
				delay=1
				url="$(auth_url)"
				if [ -n "$url" ] && [ "$url" != "$last_url" ]; then
					log_info "Waiting for authentication: $url"
					last_url="$url"
				fi
				;;
			*)
				integrated=0
				waiting=0
				delay=1
				;;
		esac
		sleep "$delay"
		load_settings
	done
}

[ "${SBPROXY_TAILSCALE_HELPER_LIBRARY_ONLY:-0}" = "1" ] && return 0

load_settings

if [ "${1:-watch}" = "cleanup" ]; then
	cleanup_openwrt_locked || fail "Failed to clean embedded Tailscale integration."
	exit 0
fi

validate_settings || fail "Invalid embedded Tailscale configuration."

case "${1:-watch}" in
	check)
		standalone_conflict && fail "Independent Tailscale is enabled or running."
		exit 0
		;;
	sync)
		[ "$ENABLED" = "1" ] || fail "Embedded Tailscale is disabled."
		[ "$(backend_state)" = "Running" ] || fail "Embedded Tailscale is not running."
		sync_openwrt_locked || fail "Failed to synchronize OpenWrt integration."
		;;
	watch)
		[ "$ENABLED" = "1" ] || exit 0
		standalone_conflict && fail "Independent Tailscale conflicts with the embedded backend."
		watch_backend
		;;
	*) fail "Unknown action: $1" ;;
esac
